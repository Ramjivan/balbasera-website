---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact Us | Bal Basera">
  <main>
    <section class="hero">
      <div class="container">
        <span class="section-label">Get In Touch</span>
        <h1>Visit Us, Write to Us</h1>
        <p class="subtitle">We welcome visits, partnerships, and conversations.</p>
      </div>
    </section>

    <section class="contact-section">
      <div class="container contact-grid">
        <div class="contact-form">
          <h2>Send a Message</h2>
          <form action="#" method="POST">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
            
            <div class="form-group">
              <label for="phone">Phone (Optional)</label>
              <input type="tel" id="phone" name="phone" />
            </div>
            
            <div class="form-group">
              <label for="subject">Subject</label>
              <select id="subject" name="subject" required>
                <option value="General Inquiry">General Inquiry</option>
                <option value="Partnership/CSR">Partnership/CSR</option>
                <option value="Volunteer">Volunteer</option>
                <option value="Visit Request">Visit Request</option>
                <option value="Other">Other</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            
            <button type="submit" class="submit-btn">Send Message</button>
          </form>
        </div>
        
        <div class="contact-info">
          <h2>Contact Information</h2>
          
          <div class="info-card">
            <h3>Address</h3>
            <p>Bal Basera<br/>JNP Plus Campus<br/>Jodhpur, Rajasthan</p>
          </div>
          
          <div class="info-card">
            <h3>Phone</h3>
            <p>+91 XXXXX XXXXX</p>
          </div>
          
          <div class="info-card">
            <h3>Email</h3>
            <p>contact@balbasera.example.com</p>
          </div>

          <div class="parent-org-note">
            <p>Bal Basera is an initiative of JNP Plus. For more about the parent organization, visit <a href="https://jnpplus.org" target="_blank" rel="noopener noreferrer">jnpplus.org</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="map-section">
      <div class="container">
        <div class="map-placeholder">
          [Google Maps Embed - Coming Soon]
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :root {
    --color-sunflower: #F4A623;
    --color-sky: #4A90D9;
    --color-warm-white: #FFF9F0;
    --color-charcoal: #2D2D2D;
    --color-light-gray: #f5f5f5;
  }

  main {
    color: var(--color-charcoal);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero {
    background-color: var(--color-warm-white);
    padding: 3rem 0 2rem 0;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    color: var(--color-sky);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
    color: var(--color-charcoal);
  }

  .subtitle {
    font-size: 1.125rem;
    color: #555;
    margin: 0;
  }

  .contact-section {
    padding: 3rem 0;
    background-color: #ffffff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .contact-form h2, .contact-info h2 {
    font-size: 1.75rem;
    color: var(--color-sky);
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
  }
  
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-sky);
    box-shadow: 0 0 0 2px rgba(74, 144, 217, 0.2);
  }

  .submit-btn {
    background: linear-gradient(135deg, var(--color-sunflower), #d98e10);
    color: #fff;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .submit-btn:hover {
    opacity: 0.9;
  }

  .info-card {
    background-color: var(--color-warm-white);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  }

  .info-card h3 {
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
    font-size: 1.125rem;
  }

  .info-card p {
    margin: 0;
    color: #555;
    line-height: 1.5;
  }

  .parent-org-note {
    margin-top: 2rem;
    padding: 1.5rem;
    background-color: rgba(74, 144, 217, 0.1);
    border-left: 4px solid var(--color-sky);
    border-radius: 0 4px 4px 0;
  }

  .parent-org-note p {
    margin: 0;
    color: var(--color-charcoal);
    line-height: 1.5;
  }

  .parent-org-note a {
    color: var(--color-sky);
    font-weight: 600;
    text-decoration: none;
  }

  .parent-org-note a:hover {
    text-decoration: underline;
  }

  .map-section {
    padding-bottom: 3rem;
  }

  .map-placeholder {
    background-color: var(--color-light-gray);
    width: 100%;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: #777;
    font-weight: 500;
    border: 1px dashed #ccc;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
