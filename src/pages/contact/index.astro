---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact Us | Bal Basera">
  <main>
    <section class="hero">
      <div class="container">
        <span class="section-label">Get In Touch</span>
        <h1>Visit Us, Write to Us</h1>
        <p class="subtitle">We welcome visits, partnerships, and conversations.</p>
      </div>
    </section>

    <section class="contact-section">
      <div class="container contact-grid">
        <div class="contact-form">
          <h2>Send a Message</h2>
          <form id="bb-contact-form" novalidate>
            <input type="hidden" name="_subject" value="New Inquiry — Bal Basera Website (balbasera.jnpplus.org)" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" style="display:none" />

            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" placeholder="e.g. Ramesh Kumar" required />
            </div>
            
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" required />
            </div>
            
            <div class="form-group">
              <label for="phone">Phone Number (Optional)</label>
              <input type="tel" id="phone" name="phone" placeholder="+91 98XXX XXXXX" />
            </div>
            
            <div class="form-group">
              <label for="subject">Subject *</label>
              <select id="subject" name="subject" required>
                <option value="">Select a topic</option>
                <option value="General Inquiry">General Inquiry</option>
                <option value="Partnership/CSR">Partnership / CSR Collaboration</option>
                <option value="Volunteer">Volunteering at Bal Basera</option>
                <option value="Visit Request">Visit / Meet the Children</option>
                <option value="Child Support/Sponsorship">Child Support / Sponsorship</option>
                <option value="Other">Other</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="message">Your Message *</label>
              <textarea id="message" name="message" rows="5" placeholder="How can we help you or how would you like to support Bal Basera?…" required></textarea>
            </div>

            <!-- Cloudflare Turnstile Bot Protection -->
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAEksM_Zuf2n395ly" data-theme="light" style="margin-bottom: 1.25rem;"></div>
            
            <button type="submit" id="bb-submit-btn" class="submit-btn">Send Message →</button>
            <p style="font-size:0.8rem;color:#777;margin-top:0.75rem;text-align:center;">Your information is kept confidential and sent directly to our team.</p>
          </form>
        </div>
        
        <div class="contact-info">
          <h2>Contact Information</h2>
          
          <div class="info-card">
            <h3>Address</h3>
            <p>Bal Basera<br/>Plot No. 17, Gayatri Nagar<br/>Opp. Paliwal Eye Hospital, Pal Road<br/>Jodhpur-342008, Rajasthan</p>
          </div>
          
          <div class="info-card">
            <h3>Phone</h3>
            <p>+91 94135 77969</p>
          </div>
          
          <div class="info-card">
            <h3>Email</h3>
            <p>jodhpursansthan@yahoo.co.in</p>
          </div>

          <div class="parent-org-note">
            <p>Bal Basera is an initiative of JNP Plus. For more about the parent organization, visit <a href="https://jnpplus.org" target="_blank" rel="noopener noreferrer">jnpplus.org</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="map-section">
      <div class="container">
        <iframe 
          src="https://maps.google.com/maps?q=26.2420127,72.9743049&z=17&output=embed" 
          width="100%" 
          height="400" 
          style="border:0; border-radius: 8px;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </section>
  </main>
</Layout>

<style>
  :root {
    --color-sunflower: #F4A623;
    --color-sky: #4A90D9;
    --color-warm-white: #FFF9F0;
    --color-charcoal: #2D2D2D;
    --color-light-gray: #f5f5f5;
  }

  main {
    color: var(--color-charcoal);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero {
    background-color: var(--color-warm-white);
    padding: 3rem 0 2rem 0;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    color: var(--color-sky);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
    color: var(--color-charcoal);
  }

  .subtitle {
    font-size: 1.125rem;
    color: #555;
    margin: 0;
  }

  .contact-section {
    padding: 3rem 0;
    background-color: #ffffff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .contact-form h2, .contact-info h2 {
    font-size: 1.75rem;
    color: var(--color-sky);
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
  }
  
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-sky);
    box-shadow: 0 0 0 2px rgba(74, 144, 217, 0.2);
  }

  .submit-btn {
    background: linear-gradient(135deg, var(--color-sunflower), #d98e10);
    color: #fff;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .submit-btn:hover {
    opacity: 0.9;
  }

  .info-card {
    background-color: var(--color-warm-white);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  }

  .info-card h3 {
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
    font-size: 1.125rem;
  }

  .info-card p {
    margin: 0;
    color: #555;
    line-height: 1.5;
  }

  .parent-org-note {
    margin-top: 2rem;
    padding: 1.5rem;
    background-color: rgba(74, 144, 217, 0.1);
    border-left: 4px solid var(--color-sky);
    border-radius: 0 4px 4px 0;
  }

  .parent-org-note p {
    margin: 0;
    color: var(--color-charcoal);
    line-height: 1.5;
  }

  .parent-org-note a {
    color: var(--color-sky);
    font-weight: 600;
    text-decoration: none;
  }

  .parent-org-note a:hover {
    text-decoration: underline;
  }

  .map-section {
    padding-bottom: 3rem;
  }

  .map-placeholder {
    background-color: var(--color-light-gray);
    width: 100%;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: #777;
    font-weight: 500;
    border: 1px dashed #ccc;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
const form = document.getElementById('bb-contact-form') as HTMLFormElement;
const btn  = document.getElementById('bb-submit-btn') as HTMLButtonElement;

form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  
  if (!form.checkValidity()) {
    form.reportValidity();
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Sending Message...';
  btn.style.opacity = '0.8';

  const formData = new FormData(form);

  try {
    const res = await fetch('https://formsubmit.co/ajax/jodhpursansthan@yahoo.co.in', {
      method: 'POST',
      body: formData,
      headers: {
        'Accept': 'application/json'
      }
    });

    const data = await res.json();

    if (res.ok && data.success !== 'false') {
      btn.textContent = "✅ Message sent! We'll be in touch soon.";
      btn.style.background = '#2E7D32';
      form.reset();
    } else {
      btn.textContent = "⚠️ Error sending. Please email us directly.";
      btn.style.background = '#D32F2F';
    }
  } catch (err) {
    btn.textContent = "⚠️ Error sending. Please email us directly.";
    btn.style.background = '#D32F2F';
  } finally {
    setTimeout(() => {
      btn.textContent = 'Send Message →';
      btn.style.background = '';
      btn.style.opacity = '1';
      btn.disabled = false;
    }, 5000);
  }
});
</script>
