---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "Bal Basera is a child care home, an initiative of JNP Plus Jodhpur, providing a nurturing environment.",
  ogImage = "/photos/default-og.jpg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Bal Basera`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    
    <title>{title} | Bal Basera</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georgia&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navbar />
    
    <main class="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Ensure footer sticks to bottom if page content is short */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  
  .main-content {
    flex: 1;
  }
</style>
