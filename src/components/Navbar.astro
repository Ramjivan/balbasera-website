---
const currentPath = Astro.url.pathname;
const links = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
  { name: 'Programs', url: '/programs/' },
  { name: 'Gallery', url: '/gallery/' },
  { name: 'Contact', url: '/contact/' },
];
---

<header class="navbar" id="main-nav">
  <div class="container nav-container">
    <div class="logo">
      <a href="/" class="logo-title" style="text-decoration: none;">Bal Basera</a>
      <a href="https://jnpplus.org" target="_blank" class="logo-subtitle" style="text-decoration: none;">An Initiative of JNP Plus ↗</a>
    </div>

    <nav class="desktop-nav">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.url} class={currentPath === link.url ? 'active' : ''}>
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="mobile-menu-btn" aria-label="Toggle Menu" id="menu-btn" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="mobile-drawer" id="mobile-drawer">
    <nav class="mobile-nav">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.url} class={currentPath === link.url ? 'active' : ''}>
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .navbar {
    background-color: var(--white);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s ease;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .logo-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--sunflower-dark);
    line-height: 1;
    margin-bottom: 2px;
  }

  .logo-subtitle {
    font-size: 0.75rem;
    color: var(--charcoal-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .desktop-nav a {
    font-weight: 500;
    color: var(--charcoal);
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.2s ease;
  }

  .desktop-nav a:hover {
    color: var(--sunflower-dark);
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--sunflower);
    transition: width 0.3s ease;
  }

  .desktop-nav a.active::after, .desktop-nav a:hover::after {
    width: 100%;
  }

  .mobile-menu-btn {
    background: none;
    border: none;
    color: var(--charcoal);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .mobile-drawer {
    position: absolute;
    top: 72px;
    left: 0;
    width: 100%;
    background-color: var(--white);
    box-shadow: var(--shadow-md);
    transform: translateY(-150%);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    z-index: 99;
  }

  .mobile-drawer.open {
    transform: translateY(0);
    opacity: 1;
  }

  .mobile-nav ul {
    list-style: none;
    padding: 1rem 0;
  }

  .mobile-nav a {
    display: block;
    padding: 1rem 2rem;
    font-weight: 500;
    color: var(--charcoal);
    border-bottom: 1px solid var(--ivory-dark);
  }

  .mobile-nav a.active {
    color: var(--sunflower-dark);
    background-color: var(--warm-white);
    border-left: 4px solid var(--sunflower);
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
    .mobile-menu-btn {
      display: none;
    }
    .mobile-drawer {
      display: none;
    }
  }
</style>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');

  if (menuBtn && mobileDrawer) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileDrawer.classList.toggle('open');
    });
  }
</script>
